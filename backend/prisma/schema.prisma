generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  DENTIST
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  DELETED
}

model User {
  id String @id @default(cuid())
  phone String @unique
  fullName String
  role Role @default(USER)
  status UserStatus @default(ACTIVE)
  deletedAt DateTime?
  deletedById String?
  bannedAt DateTime?
  bannedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedBy User? @relation( "deletedUsers", fields: [deletedById], references: [id], onDelete: SetNull)

  deletedUsers User[] @relation("deletedUsers")

  bannedBy User? @relation( "bannedUsers", fields: [bannedById], references: [id], onDelete: SetNull)
  bannedUsers User[] @relation("bannedUsers")

  @@map("users")
}